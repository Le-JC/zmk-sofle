#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE      &kp N1          &kp N2          &kp N3       &kp N4            &kp N5    &kp UP_ARROW     &kp N6  &kp N7             &kp N8       &kp N9           &kp N0              &kp RIGHT_BRACKET
&kp TAB        &kp Q           &kp W           &kp E        &kp R             &kp T     &kp DOWN_ARROW   &kp Y   &kp U              &kp I        &kp O            &kp P               &kp LEFT_BRACKET
&kp BACKSLASH  &mt LEFT_ALT A  &mt LEFT_GUI S  &mt LCTRL D  &mt LEFT_SHIFT F  &kp G     &kp LEFT_ARROW   &kp H   &mt RIGHT_SHIFT J  &mt RCTRL K  &mt RIGHT_GUI L  &mt RIGHT_ALT SEMI  &kp APOS
&kp LSHFT      &kp Z           &kp X           &kp C        &kp V             &kp B     &kp RIGHT_ARROW  &kp N   &kp M              &kp COMMA    &kp DOT          &kp FSLH            &kp RIGHT_SHIFT
&kp C_MUTE     &mo 4           &kp BACKSPACE   &mo 1        &kp SPACE         &trans    &kp ENTER        &trans  &kp ENTER          &mo 2        &kp DELETE       &mo 5
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Base";
        };

        Numbers {
            bindings = <
&trans      &trans     &trans         &trans         &trans          &trans    &mmv MOVE_UP     &kp GRAVE         &kp LS(NUMBER_4)  &kp KP_SLASH  &kp KP_MULTIPLY  &trans       &trans
&trans      &trans     &kp LC(LS(X))  &kp LC(LS(C))  &kp LC(LS(V))   &trans    &mmv MOVE_DOWN   &kp RS(RPAR)      &kp NUMBER_7      &kp NUMBER_8  &kp NUMBER_9     &kp MINUS    &kp RA(RBKT)
&mo 2       &kp LALT   &kp LGUI       &kp LCTRL      &kp LEFT_SHIFT  &trans    &mmv MOVE_LEFT   &kp RS(LPAR)      &kp NUMBER_4      &kp NUMBER_5  &kp NUMBER_6     &kp KP_PLUS  &kp RA(LBKT)
&trans      &kp LC(Z)  &kp LC(X)      &kp LC(C)      &kp LC(V)       &trans    &mmv MOVE_RIGHT  &kp LS(NUMBER_5)  &kp NUMBER_1      &kp NUMBER_2  &kp NUMBER_3     &kp EQUAL    &trans
&kp C_MUTE  &trans     &trans         &trans         &trans          &trans    &mkp LCLK        &trans            &trans            &mo 3         &kp NUMBER_0     &kp KP_DOT
            >;

            display-name = "Numbers";
            sensor-bindings = <&scroll_encoder>;
        };

        Symbols {
            bindings = <
&trans            &trans             &trans                &trans         &trans            &trans               &mmv MOVE_UP     &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6
&kp PERCENT       &kp LS(BACKSLASH)  &kp RA(BACKSLASH)     &kp RA(RBKT)   &kp RPAR          &kp RA(SEMICOLON)    &mmv MOVE_DOWN   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11  &kp F12
&kp LS(NUMBER_4)  &kp BACKSLASH      &kp RA(SINGLE_QUOTE)  &kp RA(LBKT)   &kp LPAR          &kp MINUS            &mmv MOVE_LEFT   &kp F13  &kp F14  &kp F15  &kp F16  &kp F17  &kp F18
&kp LS(NUMBER_7)  &kp RA(NUMBER_2)   &kp RA(GRAVE)         &kp RS(GRAVE)  &kp LS(NUMBER_3)  &kp UNDERSCORE       &mmv MOVE_RIGHT  &kp F19  &kp F20  &kp F21  &kp F22  &kp F23  &kp F24
&trans            &trans             &kp EXCLAMATION       &mo 3          &kp LS(NUMBER_6)  &trans               &mkp LCLK        &trans   &trans   &trans   &trans   &trans
            >;

            display-name = "Symbols";
            sensor-bindings = <&scroll_encoder>;
        };

        Movement {
            bindings = <
&kp LA(LC(F1))  &kp LA(LC(F2))  &kp LA(LC(F3))  &kp LA(LC(F4))  &kp LA(LC(F5))  &kp LA(LC(F6))    &trans  &kp LA(LC(F7))  &kp LA(LC(F8))  &kp LA(LC(F9))  &kp LA(LC(F10))  &kp LA(LC(F11))  &kp LA(LC(F12))
&trans          &trans          &trans          &trans          &trans          &trans            &trans  &kp HOME        &kp PG_DN       &kp PG_UP       &kp END          &trans           &trans
&trans          &kp LALT        &kp LGUI        &kp LCTRL       &kp LSHFT       &trans            &trans  &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT        &trans           &trans
&trans          &trans          &trans          &trans          &trans          &trans            &trans  &trans          &trans          &trans          &trans           &trans           &trans
&trans          &trans          &trans          &trans          &trans          &trans            &trans  &trans          &trans          &trans          &trans           &to 0
            >;

            display-name = "Movement";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "layer4";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
